# 复制为 .env 后填写。切勿把含真实凭据的 .env 提交到版本库。
# 所有凭据仅由进程从环境变量读取，不写入数据库、日志或报告。

# ---- 运行模式 ----
# 1（默认）= 演示数据；0 = 尝试真实数据源（必须同时完成核验并开启下方开关）
NTM_DEMO_MODE=1
# 演示数据基准日（固定以保证可复现）
NTM_AS_OF=2026-11-09

# ---- 服务 ----
NTM_HOST=0.0.0.0
NTM_PORT=8000
NTM_ENABLE_SCHEDULER=1
NTM_REFRESH_HOUR=16
NTM_REFRESH_MINUTE=30

# ---- 三重共振阈值（可按波动水平调整）----
NTM_MARKET_DROP_1D=-1.5
NTM_MARKET_DROP_5D=-4.0
NTM_ETF_SYNC_MIN=3
NTM_ETF_NET_MIN_YI=200
NTM_OFFICIAL_LOOKBACK=5

# ---- 量能观察层（辅助观测，不参与三重共振判定）----
# 放量倍数阈值：当日成交额 / 前 N 日均额 ≥ 该值记为「放量达标」
NTM_VOLUME_SPIKE_MULTIPLE=2.0
# 均线窗口（交易日数）
NTM_VOLUME_MA_WINDOW=5

# ---- 预警（可选，留空即跳过）----
# NTM_WECHAT_WEBHOOK=
# NTM_SMTP_HOST=
# NTM_SMTP_TO=
NTM_ALERT_MAX_PER_DAY=3

# ---- 真实数据源（默认禁用，接入前须完成 docs/METHODOLOGY.md 第八节核验清单）----
# 0 = 演示数据；1 = 启用已核验的真实数据源适配器
NTM_ENABLE_LIVE_ADAPTERS=0
# 真实数据源端点：必须是已完成授权/字段/频控核验的 HTTP 接口，留空即不启用
NTM_DATA_ENDPOINT=
# 凭据：仅从环境变量读取，切勿写进本文件或提交到版本库
NTM_DATA_API_KEY=
# 核验清单是否已完成并留档：0 = 未完成（拒绝启用真实源），1 = 已完成
NTM_DATA_VERIFIED=0
# 请求超时（秒）与最小请求间隔（秒，频控）
NTM_DATA_TIMEOUT=10
NTM_DATA_MIN_INTERVAL=1.0

# ---- Wind MCP 适配器（NTM_DATA_SOURCE=wind_mcp 时生效）----
# 切换真实数据需要同时设置：NTM_DEMO_MODE=0、NTM_ENABLE_LIVE_ADAPTERS=1、
# NTM_DATA_SOURCE=wind_mcp、NTM_DATA_ENDPOINT、NTM_DATA_API_KEY、NTM_DATA_VERIFIED=1。
# 端点为 Wind MCP Streamable HTTP，凭据为 Wind 后台生成的长期 API Key（ak_ 开头）。
# 字段口径与核验记录见 docs/METHODOLOGY.md 第 8.1 节、src/ntm/adapters/wind_mcp.py。
# NTM_DATA_SOURCE=wind_mcp
# NTM_WIND_BACKFILL_DAYS=12      # 单次最多补抓的交易日数，控制调用次数与配额
# NTM_WIND_KLINE_DAYS=120        # 指数 K 线回溯自然日数（算 5 日涨跌幅与画图）
# NTM_WIND_TIMEOUT=25            # 单次 MCP 请求超时（秒）
# NTM_WIND_MIN_INTERVAL=0.4      # 相邻 MCP 调用最小间隔（秒，频控）

# ---- L3 官方公告（人工核验通道）----
# 系统不自动判定官方公告是否 supportive。如需录入，放置
# data/verified_announcements.json，格式见 docs/DATA_DICTIONARY.md。
# 文件不存在即为空列表，三重共振的「官方」条件不会因新闻误触发。

# ---- 定时刷新 ----
# 二选一：NTM_ENABLE_SCHEDULER=1（应用内线程），或系统 cron 调 /api/refresh。
# 生产推荐 cron 调 API：CLI 在 cron 中不会自动加载本 .env，会丢失凭据。
# 见 deploy/crontab.example。
