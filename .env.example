# 复制为 .env 后填写。切勿把含真实凭据的 .env 提交到版本库。
# 所有凭据仅由进程从环境变量读取，不写入数据库、日志或报告。

# ---- 运行模式 ----
# 1（默认）= 演示数据；0 = 尝试真实数据源（必须同时完成核验并开启下方开关）
NTM_DEMO_MODE=1
# 演示数据基准日（固定以保证可复现）
NTM_AS_OF=2026-11-09

# ---- 服务 ----
NTM_HOST=0.0.0.0
NTM_PORT=8000
NTM_ENABLE_SCHEDULER=1
NTM_REFRESH_HOUR=16
NTM_REFRESH_MINUTE=30

# ---- 三重共振阈值（可按波动水平调整）----
NTM_MARKET_DROP_1D=-1.5
NTM_MARKET_DROP_5D=-4.0
NTM_ETF_SYNC_MIN=3
NTM_ETF_NET_MIN_YI=200
NTM_OFFICIAL_LOOKBACK=5

# ---- 量能观察层（辅助观测，不参与三重共振判定）----
# 放量倍数阈值：当日成交额 / 前 N 日均额 ≥ 该值记为「放量达标」
NTM_VOLUME_SPIKE_MULTIPLE=2.0
# 均线窗口（交易日数）
NTM_VOLUME_MA_WINDOW=5

# ---- 预警（可选，留空即跳过）----
# NTM_WECHAT_WEBHOOK=
# NTM_SMTP_HOST=
# NTM_SMTP_TO=
NTM_ALERT_MAX_PER_DAY=3

# ---- 真实数据源（默认禁用，接入前须完成 docs/METHODOLOGY.md 第八节核验清单）----
# 0 = 演示数据；1 = 启用已核验的真实数据源适配器
NTM_ENABLE_LIVE_ADAPTERS=0
# 真实数据源端点：必须是已完成授权/字段/频控核验的 HTTP 接口，留空即不启用
NTM_DATA_ENDPOINT=
# 凭据：仅从环境变量读取，切勿写进本文件或提交到版本库
NTM_DATA_API_KEY=
# 核验清单是否已完成并留档：0 = 未完成（拒绝启用真实源），1 = 已完成
NTM_DATA_VERIFIED=0
# 请求超时（秒）与最小请求间隔（秒，频控）
NTM_DATA_TIMEOUT=10
NTM_DATA_MIN_INTERVAL=1.0

# ---- Wind MCP（NTM_DATA_SOURCE=wind_mcp，Linux 上优先于本机 WindPy）----
# 端点默认 https://mcp.wind.com.cn/vserver_wind_tools/mcp/
# 密钥只放 NTM_WIND_MCP_KEY，不要写入本文件，也不要复用 NTM_DATA_API_KEY。
# 仍须 NTM_DEMO_MODE=0 与 NTM_DATA_VERIFIED=1。不需要 NTM_ENABLE_LIVE_ADAPTERS。
# NTM_DATA_SOURCE=wind_mcp
# NTM_WIND_MCP_KEY=
# NTM_WIND_BACKFILL_DAYS=12      # 单次最多补抓的交易日数，控制调用次数与配额
# NTM_WIND_KLINE_DAYS=120        # 指数 K 线回溯自然日数（算 5 日涨跌幅与画图）
# NTM_WIND_TIMEOUT=25            # 单次 MCP 请求超时（秒）
# NTM_WIND_MIN_INTERVAL=0.4      # 相邻 MCP 调用最小间隔（秒，频控）

# ---- 个人终端：WindPy（NTM_DATA_SOURCE=windpy）----
# 不需要 NTM_ENABLE_LIVE_ADAPTERS。仍须 NTM_DEMO_MODE=0 与 NTM_DATA_VERIFIED=1。
# Wind 账号由本机终端保管，不要把口令写进代码或本文件。用法见 PERSONAL_USAGE.md。
# NTM_DATA_SOURCE=windpy
# NTM_WIND_SHARE_FIELD=f_unit_floortrading   # 用超级命令确认后再取消注释

# ---- 个人终端：iFinD（NTM_DATA_SOURCE=ifind）----
# 账号、密码、refresh token 只放环境变量。不要在本文件填写真实值，也不要提交。
# Linux 服务器用 refresh_token 走 HTTP，不需要 iFinDPy。不要把令牌写进本文件。
# 份额/净值默认就是下面这对（2026-11-09 与 Wind 核对过）。不要改成未核对的代码。
# NTM_DATA_SOURCE=ifind
# NTM_IFIND_REFRESH_TOKEN=
# ifind_api_refresh_token=
# ifind_api_access_token=
# NTM_IFIND_SHARE_FIELD=ths_inner_float_shares_fund
# NTM_IFIND_SHARE_PARAMS=[]
# NTM_IFIND_NAV_FIELD=ths_iopv_fund
# NTM_IFIND_NAV_PARAMS=[]

# ---- L3 官方公告（人工核验通道）----
# 系统不自动判定官方公告是否 supportive。如需录入，放置
# data/verified_announcements.json，格式见 docs/DATA_DICTIONARY.md。
# 文件不存在即为空列表，三重共振的「官方」条件不会因新闻误触发。

# ---- 定时刷新 ----
# 二选一：NTM_ENABLE_SCHEDULER=1（应用内线程），或系统 cron 调 /api/refresh。
# 生产推荐 cron 调 API：CLI 在 cron 中不会自动加载本 .env，会丢失凭据。
# 见 deploy/crontab.example。
