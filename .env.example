# 复制为 .env 后填写。切勿把含真实凭据的 .env 提交到版本库。
# 所有凭据仅由进程从环境变量读取，不写入数据库、日志或报告。

# ---- 运行模式 ----
# 1（默认）= 演示数据；0 = 尝试真实数据源（必须同时完成核验并开启下方开关）
NTM_DEMO_MODE=1
# 演示数据基准日（固定以保证可复现）
NTM_AS_OF=2026-11-09

# ---- 服务 ----
NTM_HOST=0.0.0.0
NTM_PORT=8000
NTM_ENABLE_SCHEDULER=1
NTM_REFRESH_HOUR=16
NTM_REFRESH_MINUTE=30

# ---- 三重共振阈值（可按波动水平调整）----
NTM_MARKET_DROP_1D=-1.5
NTM_MARKET_DROP_5D=-4.0
NTM_ETF_SYNC_MIN=3
NTM_ETF_NET_MIN_YI=200
NTM_OFFICIAL_LOOKBACK=5

# ---- 预警（可选，留空即跳过）----
# NTM_WECHAT_WEBHOOK=
# NTM_SMTP_HOST=
# NTM_SMTP_TO=
NTM_ALERT_MAX_PER_DAY=3

# ---- 真实数据源（默认禁用，接入前须完成 docs/METHODOLOGY.md 核验清单）----
NTM_ENABLE_LIVE_ADAPTERS=0
